<mujoco>
	<include file="scene.xml"/>
	<include file="dependencies.xml"/>
	<worldbody>
		<include file="bdx.xml" />
	</worldbody>
 	<actuator>
		<motor name="hip_yaw_l" joint="hip_yaw_l" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="hip_roll_l" joint="hip_roll_l" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="hip_pitch_l" joint="hip_pitch_l" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="knee_pitch_l" joint="knee_pitch_l" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="ankle_pitch_l" joint="ankle_pitch_l" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="hip_yaw_r" joint="hip_yaw_r" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="hip_roll_r" joint="hip_roll_r" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="hip_pitch_r" joint="hip_pitch_r" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="knee_pitch_r" joint="knee_pitch_r" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="ankle_pitch_r" joint="ankle_pitch_r" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="neck_pitch" joint="neck_pitch" gear="1" ctrllimited="true" ctrlrange="-23.7 23.7"/>
		<motor name="head_pitch" joint="head_pitch" gear="1" ctrllimited="true" ctrlrange="-8 8"/>
		<motor name="head_yaw" joint="head_yaw" gear="1" ctrllimited="true" ctrlrange="-8 8"/>
		<motor name="head_roll" joint="head_roll" gear="1" ctrllimited="true" ctrlrange="-8 8"/>
		<motor name="antenna_l" joint="antenna_l" gear="1" ctrllimited="true" ctrlrange="-3.9 3.9"/>
		<motor name="antenna_r" joint="antenna_r" gear="1" ctrllimited="true" ctrlrange="-3.9 3.9"/>
    </actuator>
    <sensor>
    	<!--pos-->
		<actuatorpos name='hip_yaw_l_p' actuator='hip_yaw_l' user='13'/>
		<actuatorpos name='hip_roll_l_p' actuator='hip_roll_l' user='13'/>
		<actuatorpos name='hip_pitch_l_p' actuator='hip_pitch_l' user='13'/>
		<actuatorpos name='knee_pitch_l_p' actuator='knee_pitch_l' user='13'/>
		<actuatorpos name='ankle_pitch_l_p' actuator='ankle_pitch_l' user='13'/>
		<actuatorpos name='hip_yaw_r_p' actuator='hip_yaw_r' user='13'/>
		<actuatorpos name='hip_roll_r_p' actuator='hip_roll_r' user='13'/>
		<actuatorpos name='hip_pitch_r_p' actuator='hip_pitch_r' user='13'/>
		<actuatorpos name='knee_pitch_r_p' actuator='knee_pitch_r' user='13'/>
		<actuatorpos name='ankle_pitch_r_p' actuator='ankle_pitch_r' user='13'/>
		<actuatorpos name='neck_pitch_p' actuator='neck_pitch' user='13'/>
		<actuatorpos name='head_pitch_p' actuator='head_pitch' user='13'/>
		<actuatorpos name='head_yaw_p' actuator='head_yaw' user='13'/>
		<actuatorpos name='head_roll_p' actuator='head_roll' user='13'/>
		<actuatorpos name='antenna_l_p' actuator='antenna_l' user='13'/>
		<actuatorpos name='antenna_r_p' actuator='antenna_r' user='13'/>

		<!--vel-->
		<actuatorvel name='hip_yaw_l_v' actuator='hip_yaw_l' user='13'/>
		<actuatorvel name='hip_roll_l_v' actuator='hip_roll_l' user='13'/>
		<actuatorvel name='hip_pitch_l_v' actuator='hip_pitch_l' user='13'/>
		<actuatorvel name='knee_pitch_l_v' actuator='knee_pitch_l' user='13'/>
		<actuatorvel name='ankle_pitch_l_v' actuator='ankle_pitch_l' user='13'/>
		<actuatorvel name='hip_yaw_r_v' actuator='hip_yaw_r' user='13'/>
		<actuatorvel name='hip_roll_r_v' actuator='hip_roll_r' user='13'/>
		<actuatorvel name='hip_pitch_r_v' actuator='hip_pitch_r' user='13'/>
		<actuatorvel name='knee_pitch_r_v' actuator='knee_pitch_r' user='13'/>
		<actuatorvel name='ankle_pitch_r_v' actuator='ankle_pitch_r' user='13'/>
		<actuatorvel name='neck_pitch_v' actuator='neck_pitch' user='13'/>
		<actuatorvel name='head_pitch_v' actuator='head_pitch' user='13'/>
		<actuatorvel name='head_yaw_v' actuator='head_yaw' user='13'/>
		<actuatorvel name='head_roll_v' actuator='head_roll' user='13'/>
		<actuatorvel name='antenna_l_v' actuator='antenna_l' user='13'/>
		<actuatorvel name='antenna_r_v' actuator='antenna_r' user='13'/>

		<!--frc-->
		<actuatorfrc name='hip_yaw_l_f' actuator='hip_yaw_l' user='13' noise='1e-3'/>
		<actuatorfrc name='hip_roll_l_f' actuator='hip_roll_l' user='13' noise='1e-3'/>
		<actuatorfrc name='hip_pitch_l_f' actuator='hip_pitch_l' user='13' noise='1e-3'/>
		<actuatorfrc name='knee_pitch_l_f' actuator='knee_pitch_l' user='13' noise='1e-3'/>
		<actuatorfrc name='ankle_pitch_l_f' actuator='ankle_pitch_l' user='13' noise='1e-3'/>
		<actuatorfrc name='hip_yaw_r_f' actuator='hip_yaw_r' user='13' noise='1e-3'/>
		<actuatorfrc name='hip_roll_r_f' actuator='hip_roll_r' user='13' noise='1e-3'/>
		<actuatorfrc name='hip_pitch_r_f' actuator='hip_pitch_r' user='13' noise='1e-3'/>
		<actuatorfrc name='knee_pitch_r_f' actuator='knee_pitch_r' user='13' noise='1e-3'/>
		<actuatorfrc name='ankle_pitch_r_f' actuator='ankle_pitch_r' user='13' noise='1e-3'/>
		<actuatorfrc name='neck_pitch_f' actuator='neck_pitch' user='13' noise='1e-3'/>
		<actuatorfrc name='head_pitch_f' actuator='head_pitch' user='13' noise='1e-3'/>
		<actuatorfrc name='head_yaw_f' actuator='head_yaw' user='13' noise='1e-3'/>
		<actuatorfrc name='head_roll_f' actuator='head_roll' user='13' noise='1e-3'/>
		<actuatorfrc name='antenna_l_f' actuator='antenna_l' user='13' noise='1e-3'/>
		<actuatorfrc name='antenna_r_f' actuator='antenna_r' user='13' noise='1e-3'/>

        <framequat     name='orientation' objtype='site' noise='0.001' objname='imu'/>
        <framepos      name='position' objtype='site' noise='0.001' objname='imu'/>
        <gyro          name='angular-velocity'    site='imu' noise='0.005' cutoff='34.9'/>
        <velocimeter   name='linear-velocity'     site='imu' noise='0.001' cutoff='30'/>
        <accelerometer name='linear-acceleration' site='imu' noise='0.005' cutoff='157'/>
        <magnetometer  name='magnetometer'        site='imu'/>
		<gyro name="imu_gyro" site="imu" noise="0.0" />
   		<accelerometer name="imu_acc" site="imu" />
		<framequat name="imu_quat" objtype="site" objname="imu" />
    </sensor>
</mujoco>
